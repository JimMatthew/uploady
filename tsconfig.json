{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],

    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noEmit": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["./**/*.ts", "./**/*.js"],
  "exclude": [
    "client",
    "node_modules",
    "dist",
    "build",
    "coverage",
    "scripts",
    "public",
    "bin"
  ]
}